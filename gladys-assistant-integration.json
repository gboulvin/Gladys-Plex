{
  "manifest_version": 1,
  "type": "device",
  "name": "Plex",
  "description": {
    "en": "Use Plex playback state in Gladys scenes, stop active playback, and receive Plex webhooks.",
    "fr": "Utilisez l’état Plex dans les scènes Gladys, arrêtez la lecture et recevez les webhooks."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/gboulvin/gladys-plex:1.0.0",
  "gladys_version": ">=4.85.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-Plex/main/cover.png",
  "transports": ["local"],
  "config_schema": [
    {
      "key": "connection",
      "type": "section",
      "label": { "en": "Plex connection", "fr": "Connexion Plex" },
      "description": {
        "en": "Use the LAN URL of Plex Media Server, not localhost. The integration runs in its own container.",
        "fr": "Utilisez l’URL réseau locale du Plex Media Server, et non localhost. L’intégration s’exécute dans son propre conteneur."
      },
      "links": [
        {
          "url": "https://developer.plex.tv/pms/",
          "label": { "en": "Plex Media Server API", "fr": "API Plex Media Server" }
        }
      ]
    },
    {
      "key": "server_url",
      "type": "string",
      "label": { "en": "Plex Media Server URL", "fr": "URL du Plex Media Server" },
      "description": {
        "en": "For example: http://192.168.1.20:32400",
        "fr": "Par exemple : http://192.168.1.20:32400"
      },
      "required": true
    },
    {
      "key": "token",
      "type": "secret",
      "label": { "en": "Plex token", "fr": "Token Plex" },
      "description": {
        "en": "The X-Plex-Token used to authenticate requests.",
        "fr": "Le X-Plex-Token utilisé pour authentifier les requêtes."
      },
      "required": true
    },
    {
      "key": "client_identifier",
      "type": "string",
      "label": { "en": "Client identifier", "fr": "Identifiant client" },
      "required": false,
      "default": "gladys-plex-integration"
    }
  ],
  "webhooks": [
    {
      "key": "plex_events",
      "label": { "en": "Plex playback events", "fr": "Événements de lecture Plex" },
      "mode": "fire_and_forget"
    }
  ],
  "actions": [
    {
      "key": "test_plex",
      "label": { "en": "Test Plex connection", "fr": "Tester la connexion Plex" },
      "timeout_seconds": 30
    },
    {
      "key": "show_webhook_url",
      "label": { "en": "Show Plex webhook URL", "fr": "Afficher l’URL webhook Plex" },
      "timeout_seconds": 30
    }
  ]
}
